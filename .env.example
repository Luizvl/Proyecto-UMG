# Copiar este archivo a .env y ajustar valores.
# Mientras no se defina DB_ENGINE=mysql, el proyecto usa SQLite (cero configuración).

DJANGO_SECRET_KEY=cambia-esta-llave-por-una-generada-para-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Descomentar para usar MySQL:
# DB_ENGINE=mysql
# DB_NAME=becas_db
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
# Gemini AI

# Correo (Gmail con contrasena de aplicacion). Dejar comentado para usar la consola.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=correo@gmail.com
# EMAIL_HOST_PASSWORD=contrasena-de-aplicacion
# DEFAULT_FROM_EMAIL=Becas UMG <correo@gmail.com>
